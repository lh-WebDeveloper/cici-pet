{
  "schemaVersion": 5,
  "app": {
    "name": "CiCi桌宠",
    "appId": "com.doubao.cicipet",
    "version": "1.0.0",
    "language": "zh-CN"
  },
  "targets": {
    "windows": {
      "enabled": false,
      "arch": "x64"
    },
    "macos": {
      "enabled": true,
      "arch": "current"
    }
  },
  "character": {
    "inputType": "single-image",
    "coreAsset": "core-ip/core-ip.png",
    "displayName": "CiCi",
    "archetype": "person",
    "personality": [
      "活泼",
      "可爱",
      "有点小俏皮",
      "亲人"
    ],
    "preserveTraits": [
      "米色棒球帽",
      "黑色圆框眼镜",
      "棕色长直发",
      "黑色外套",
      "金色小蝴蝶项链",
      "圆脸与大眼睛"
    ],
    "style": "balanced-cartoon",
    "mirrorSafe": true
  },
  "assetPipeline": {
    "backgroundMode": "semantic-cutout",
    "segmentationBackend": "apple-vision",
    "subjectKind": "photo",
    "generationBackground": "solid-chroma",
    "backgroundTolerance": 28,
    "edgeFeather": 12,
    "safeMargin": 24,
    "targetOccupancy": 0.78
  },
  "experience": {
    "theme": {
      "primary": "#6B4A36",
      "accent": "#E89AA6",
      "background": "#FFF4E8",
      "surface": "#FFFFFF",
      "text": "#3B2E26",
      "muted": "#9C8B7E",
      "cornerRadius": 20
    },
    "petSizing": {
      "baseWindowPx": 220,
      "defaultScale": 0.8
    },
    "interactions": [
      {
        "id": "chat",
        "emoji": "💬",
        "label": "陪我聊聊天",
        "stateId": "chat",
        "durationMs": 1600,
        "affectionGain": 2,
        "feedback": [
          "今天也要开心呀~",
          "嘿嘿，被你发现啦",
          "工作别太累，记得喝水哦",
          "想你啦，今天过得怎么样？",
          "嘿嘿，我一直陪着你呢",
          "今天摸鱼了没？我盯着你哦"
        ]
      },
      {
        "id": "pet-head",
        "emoji": "🤗",
        "label": "摸摸头",
        "stateId": "pet",
        "durationMs": 1500,
        "affectionGain": 3,
        "feedback": [
          "好舒服呀，再摸两下",
          "再摸一下嘛~就一下",
          "嘻嘻，头上要长蘑菇啦",
          "你的手好温暖呀",
          "被宠爱的感觉真好",
          "不要停，继续继续"
        ]
      },
      {
        "id": "feed-snack",
        "emoji": "🍪",
        "label": "喂吃的",
        "stateId": "eat",
        "durationMs": 1800,
        "affectionGain": 5,
        "feedback": [
          "哇！是我最爱的小饼干",
          "好吃！还要还要",
          "吧唧吧唧……真满足",
          "谢谢你喂我，你真好",
          "小肚子开始圆滚滚啦",
          "下次请你喝奶茶呀"
        ]
      },
      {
        "id": "sleep",
        "emoji": "😴",
        "label": "让她睡觉",
        "stateId": "sleep",
        "durationMs": 2400,
        "affectionGain": 1,
        "feedback": [
          "呼……呼……Zzz",
          "困了，让我眯一会儿",
          "晚安，做个甜甜的梦",
          "别吵哦，我在充电呢",
          "睡得好香，别叫醒我",
          "梦里全是好吃的"
        ]
      },
      {
        "id": "wave",
        "emoji": "👋",
        "label": "挥挥手",
        "stateId": "wave",
        "durationMs": 1800,
        "affectionGain": 2,
        "feedback": [
          "嗨！看到你啦~",
          "嘿嘿，我在这儿呢",
          "跟你挥个手呀",
          "今天也要加油哦",
          "招手即停，不许忽略我",
          "嗨嗨，我一直都在"
        ]
      },
      {
        "id": "dance",
        "emoji": "💃",
        "label": "跳个舞",
        "stateId": "dance",
        "durationMs": 2400,
        "affectionGain": 3,
        "feedback": [
          "动次打次~",
          "我一开心就想跳舞",
          "你陪我一起跳嘛",
          "蹦蹦蹦，心情超好",
          "跳完啦，快鼓掌",
          "要不要再来一段？"
        ]
      },
      {
        "id": "angry",
        "emoji": "😠",
        "label": "逗她生气",
        "stateId": "angry",
        "durationMs": 1500,
        "affectionGain": 0,
        "feedback": [
          "哼！不理你了",
          "你再戳一下试试",
          "气鼓鼓",
          "哼，我记仇了"
        ]
      },
      {
        "id": "cute",
        "emoji": "🥺",
        "label": "撒个娇",
        "stateId": "cute",
        "durationMs": 1600,
        "affectionGain": 4,
        "feedback": [
          "拜托嘛~",
          "好不好嘛",
          "人家想要",
          "嘤嘤",
          "你最好了"
        ]
      },
      {
        "id": "sleepy",
        "emoji": "😪",
        "label": "看她犯困",
        "stateId": "sleepy",
        "durationMs": 2000,
        "affectionGain": 1,
        "feedback": [
          "好困哦...",
          "眼皮在打架",
          "不行，撑住",
          "呼..."
        ]
      },
      {
        "id": "jump",
        "emoji": "🤸",
        "label": "开心跳",
        "stateId": "jump",
        "durationMs": 1800,
        "affectionGain": 3,
        "feedback": [
          "耶！",
          "太开心啦",
          "蹦蹦蹦",
          "再来一个"
        ]
      },
      {
        "id": "shy",
        "emoji": "☺️",
        "label": "逗她害羞",
        "stateId": "shy",
        "durationMs": 1500,
        "affectionGain": 3,
        "feedback": [
          "讨厌啦",
          "人家害羞了",
          "不要这样看我嘛",
          "嘿嘿"
        ]
      },
      {
        "id": "cheer",
        "emoji": "🎉",
        "label": "惊喜挥手",
        "stateId": "cheer",
        "durationMs": 1600,
        "affectionGain": 2,
        "feedback": [
          "呀！见到你真开心",
          "嗨~",
          "我在这呢",
          "挥挥小手"
        ]
      },
      {
        "id": "sad",
        "emoji": "😢",
        "label": "惹她委屈",
        "stateId": "sad",
        "durationMs": 2000,
        "affectionGain": 0,
        "feedback": [
          "呜...",
          "你是不是不要我了",
          "好委屈",
          "抱抱我嘛"
        ]
      },
      {
        "id": "surprise",
        "emoji": "😲",
        "label": "惊讶",
        "stateId": "surprise",
        "durationMs": 900,
        "affectionGain": 1,
        "feedback": [
          "哇！吓我一跳",
          "咦？什么事这么突然",
          "你总是给我惊喜~",
          "咿——！"
        ]
      }
    ]
  },
